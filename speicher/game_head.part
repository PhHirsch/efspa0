/* Español EF – Login, Münzen, Avatar (gemeinsam für alle Spiele) */
(function () {
  // Web-App-URL aus Google Apps Script (Bereitstellung). Leer = ohne Login.
  const API_URL = "/*API_URL*/";

  const CATALOG = /*CATALOG*/;
  const SLOTS = ["skin", "eyes", "lashes", "face", "hairstyle", "haircolor", "top", "hat", "glasses", "jewellery", "extra", "aura", "bg"];
  const TABS = [["Cara", ["skin", "eyes", "lashes", "face"]], ["Pelo", ["hairstyle", "haircolor"]], ["Ropa", ["top"]], ["Sombreros", ["hat"]], ["Gafas", ["glasses"]], ["Joyas", ["jewellery"]], ["Extras", ["extra", "aura"]], ["Fondos", ["bg"]]];
  const SLOTNAME = { skin: "Tono de piel", eyes: "Ojos", lashes: "Forma de los ojos", face: "Pintura y pegatinas", hairstyle: "Peinado", haircolor: "Color de pelo", top: "Ropa", hat: "Sombreros", glasses: "Gafas", jewellery: "Joyas", extra: "Mascotas y gadgets", aura: "Aura", bg: "Fondos" };
  const DEFAULT = { skin: "skin2", eyes: "eye-brown", lashes: "lash-off", face: "face-none", hairstyle: "hs-short", haircolor: "hc-brown", top: "top-tshirt-white", hat: "hat-none", glasses: "gl-none", jewellery: "jw-none", extra: "ex-none", aura: "aura-none", bg: "bg-plain" };
  const LEVEL_XP = [0, 50, 120, 220, 350, 500, 700, 950, 1250, 1600, 2000, 2500];
  const LEVEL_NAMES = ["", "Aprendiz", "Aprendiz", "Talento", "Talento", "Pro", "Pro", "Estrella", "Estrella", "Leyenda", "Leyenda", "Leyenda+"];
  const ACTIVE_UNITS = /*UNITS*/;
  const SKEY = "efspa0session", MAXAGE = 90 * 60 * 1000;

  function getSession() {
    try {
      const s = JSON.parse(sessionStorage.getItem(SKEY));
      if (s && Date.now() - s.t < MAXAGE) return s;
      sessionStorage.removeItem(SKEY);
    } catch (e) {}
    return null;
  }
  function setSession(s) { s.t = Date.now(); try { sessionStorage.setItem(SKEY, JSON.stringify(s)); } catch (e) {} }
  function logout() { try { sessionStorage.removeItem(SKEY); } catch (e) {} }

  /* Warteschlange: Ergebnisse ohne Verbindung (ohne PIN!) auf dem Gerät merken und später senden */
  const QKEY = SKEY + "-queue";
  function qGet() { try { return JSON.parse(localStorage.getItem(QKEY)) || []; } catch (e) { return []; } }
  function qSet(a) { try { localStorage.setItem(QKEY, JSON.stringify(a)); } catch (e) {} }
  let flushing = false;
  async function flushQueue() {
    const s = getSession(); if (!s || flushing) return;
    const mine = qGet().filter(x => x.nr === s.nr); if (!mine.length) return;
    flushing = true;
    for (const it of mine) {
      const r = await api("result", Object.assign({ nr: s.nr, pin: s.pin }, it.data));
      if (!r.ok && r.error === "network") break;
      qSet(qGet().filter(x => x.id !== it.id));
      if (r.ok && r.state) { const t = getSession(); if (t) { t.state = r.state; setSession(t); } }
    }
    flushing = false;
  }

  async function api(action, data) {
    if (!API_URL || API_URL.indexOf("/*") === 0) return { ok: false, error: "offline" };
    try {
      const r = await fetch(API_URL, { method: "POST", body: JSON.stringify(Object.assign({ action: action }, data)) });
      return await r.json();
    } catch (e) { return { ok: false, error: "network" }; }
  }
  async function login(nr, pin) {
    const r = await api("login", { nr: String(nr).trim(), pin: String(pin).trim() });
    if (r.ok) { setSession({ nr: String(nr).trim(), pin: String(pin).trim(), state: r.state }); flushQueue(); }
    return r;
  }
  async function setPin(newpin) {
    const s = getSession();
    if (!s) return { ok: false, error: "nologin" };
    const r = await api("setpin", { nr: s.nr, pin: s.pin, newpin: String(newpin).trim() });
    if (r.ok) { s.pin = String(newpin).trim(); s.state = r.state; setSession(s); }
    return r;
  }
  async function call(action, extra) {
    const s = getSession();
    if (!s) return { ok: false, error: "nologin" };
    const r = await api(action, Object.assign({ nr: s.nr, pin: s.pin }, extra || {}));
    if (r.ok && r.state) { s.state = r.state; setSession(s); }
    if (r.ok && action !== "result") flushQueue();
    if (r.error === "login" || r.error === "locked") logout();
    return r;
  }
  function errText(e) {
    return ({
      offline: "El login todavía no está listo. – Login ist noch nicht eingerichtet.",
      network: "No hay conexión. Inténtalo otra vez. – Keine Verbindung, versuch es nochmal.",
      login: "Número o PIN incorrecto. – Nummer oder PIN falsch.",
      locked: "Demasiados intentos. Espera 5 minutos. – Zu viele Fehlversuche, warte 5 Minuten.",
      coins: "No tienes suficientes monedas. – Nicht genug Münzen.",
      nologin: "Inicia sesión en la página principal. – Bitte auf der Startseite anmelden.",
      server: "Error del servidor. Inténtalo otra vez. – Serverfehler, versuch es nochmal.",
      weakpin: "Este PIN es demasiado fácil. Elige otro. – Diese PIN ist zu leicht zu erraten.",
      samepin: "Elige un PIN nuevo, no el antiguo. – Wähle eine neue PIN, nicht die alte.",
      pinmatch: "Los dos PIN no son iguales. – Die beiden PINs sind nicht gleich.",
      level: "Necesitas un nivel más alto. – Dafür brauchst du ein höheres Level.",
      stars: "Necesitas más estrellas. – Dafür brauchst du mehr Sterne.", adv: "Primero abre más puertas del calendario de Adviento. – Erst mehr Türchen im Adventskalender öffnen."
    })[e] || ("Error: " + e);
  }

  /* ----- Belohnungs-Effekte (nur Optik) ----- */
  function fxCss() {
    if (document.getElementById("e8fx")) return;
    const st = document.createElement("style"); st.id = "e8fx";
    st.textContent = `.e8coin{position:fixed;z-index:90;font-size:26px;pointer-events:none;animation:e8c 1.1s cubic-bezier(.3,.7,.4,1) forwards}
      @keyframes e8c{0%{transform:translate(0,0) scale(.4);opacity:0}20%{opacity:1;transform:translate(calc(var(--x)*.3),-40px) scale(1.2)}100%{transform:translate(var(--x),var(--y)) scale(.6);opacity:0}}
      .e8lv{position:fixed;inset:0;z-index:95;background:radial-gradient(circle at 50% 40%,rgba(255,210,58,.35),rgba(5,6,12,.92) 60%);display:flex;align-items:center;justify-content:center;padding:16px;animation:e8in .3s}
      .e8lv .c{max-width:520px;width:100%;text-align:center;color:#fff;font-family:inherit}
      .e8lv .n{font-size:96px;font-weight:900;line-height:1;color:#ffd23a;text-shadow:0 0 30px #ff9a2a,0 6px 0 #a05a00;animation:e8pop .7s cubic-bezier(.2,1.6,.4,1)}
      .e8lv .av{width:150px;height:150px;margin:10px auto;border-radius:50%;overflow:hidden;border:5px solid #ffd23a;box-shadow:0 0 40px #ffd23a}
      .e8lv .it{display:inline-block;width:86px;margin:5px;vertical-align:top;font-size:12px;font-weight:700}
      .e8lv .it div{width:86px;height:86px;border-radius:12px;overflow:hidden;border:2px solid #ffd23a}
      .e8lv button{font-size:22px;font-weight:900;padding:12px 34px;border-radius:12px;border:0;background:#ffd23a;color:#2a1600;margin-top:14px;cursor:pointer}
      .e8cf{position:fixed;width:10px;height:14px;top:35%;left:50%;z-index:96;pointer-events:none;border-radius:2px;animation:e8cf 1.6s ease-out forwards}
      @keyframes e8cf{to{transform:translate(var(--x),var(--y)) rotate(var(--r));opacity:0}}
      @keyframes e8pop{0%{transform:scale(.2)}100%{transform:scale(1)}} @keyframes e8in{from{opacity:0}}`;
    document.head.appendChild(st);
  }
  function rewardFx(box, earned) {
    fxCss();
    const el = box.querySelector(".e8earn"); if (!el) return;
    const t0 = performance.now(), dur = Math.min(1200, 300 + earned * 25);
    const tick = t => { const f = Math.min(1, (t - t0) / dur); el.textContent = Math.round(earned * f); if (f < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
    if (!earned) return;
    const r = box.getBoundingClientRect(), n = Math.min(14, 4 + Math.round(earned / 5));
    for (let i = 0; i < n; i++) setTimeout(() => {
      const c = document.createElement("div"); c.className = "e8coin"; c.textContent = "🪙";
      c.style.left = (r.left + r.width / 2 - 13) + "px"; c.style.top = (r.top + 10) + "px";
      c.style.setProperty("--x", ((Math.random() * 2 - 1) * 160) + "px"); c.style.setProperty("--y", (-120 - Math.random() * 160) + "px");
      document.body.appendChild(c); setTimeout(() => c.remove(), 1200);
    }, i * 60);
  }
  function confettiFx(n) {
    const C = ["#ffd23a", "#ff4f8b", "#3ab0ff", "#3fd27a", "#ff8a2a", "#a05cf0"];
    for (let i = 0; i < n; i++) { const e = document.createElement("i"); e.className = "e8cf";
      e.style.cssText = `background:${C[i % 6]};--x:${(Math.random() * 2 - 1) * 48}vw;--y:${(Math.random() * 1.3 - .2) * 55}vh;--r:${Math.random() * 900}deg;left:${44 + Math.random() * 12}%`;
      document.body.appendChild(e); setTimeout(() => e.remove(), 1700); }
  }
  function levelUp(from, st) {
    fxCss();
    const lv = st.level, nu = CATALOG.filter(i => i.lvl && i.lvl > from && i.lvl <= lv && (!i.unit || ACTIVE_UNITS.indexOf(i.unit) >= 0));
    const d = document.createElement("div"); d.className = "e8lv";
    d.innerHTML = `<div class="c"><div style="font-size:18px;font-weight:800;letter-spacing:.2em">¡SUBES DE NIVEL!</div><div class="n">${lv}</div>
      <div style="font-size:24px;font-weight:900">${(LEVEL_NAMES[lv] || "Leyenda+").toUpperCase()}</div><div class="av">${avatarSVG(st.equipped)}</div>
      ${nu.length ? `<div style="font-weight:800;margin-top:6px">🔓 ¡Nuevo en la tienda! <span style="opacity:.7;font-weight:500">– Neu freigeschaltet:</span></div><div>${nu.slice(0, 6).map(i => `<span class="it"><div>${avatarSVG(Object.assign({}, st.equipped, { [i.slot]: i.id }))}</div>${i.name}</span>`).join("")}</div>` : ""}
      <button>¡GENIAL! ▶</button></div>`;
    document.body.appendChild(d); confettiFx(80); setTimeout(() => confettiFx(50), 500);
    d.querySelector("button").onclick = () => d.remove();
  }

  /* Ergebnis am Ende eines Spiels melden und anzeigen */
  function reportInto(elId, game, S, save) {
    const box = document.getElementById(elId);
    if (!box) return;
    if (!API_URL || API_URL.indexOf("/*") === 0) { box.style.display = "none"; return; }
    const se = getSession();
    const prevLevel = se && se.state ? se.state.level : 0;
    const prevStreakToday = se && se.state ? !!se.state.streakToday : true;
    const prevCoins = se && se.state ? se.state.coins : 0;
    const show = r => {
      if (r.queued) { box.innerHTML = "📡 Ahora no hay internet. Tu resultado está guardado en este aparato y se envía automáticamente cuando estés online con tu sesión iniciada.<div style='font-size:14px;opacity:.75'>Kein Internet: Dein Ergebnis ist gespeichert und wird später automatisch gesendet.</div>"; return; }
      let t = `<div style="font-size:30px;font-weight:900">+<span class="e8earn">0</span> 🪙</div>`;
      t += `<div>${"⭐".repeat(r.stars)}${"☆".repeat(3 - r.stars)} · Ahora tienes <b>${r.state.coins} 🪙</b>.</div>`;
      if (!r.first && !r.improved && !r.daily) t += `<div style="font-size:14px;opacity:.75">Ya lo jugaste: menos monedas. ¡Más estrellas = más monedas! – Wiederholung: weniger Münzen, mehr Sterne bringen mehr.</div>`;
      if (r.improved) t += `<div style="font-size:14px;opacity:.75">¡Nuevo récord! – Neuer Rekord!</div>`;
      if (r.review && !r.earned) t += `<div style="font-size:14px;opacity:.75">Monedas de la caja de errores solo 1 vez al día. – Münzen für die Fehler-Kiste gibt es nur 1x pro Tag.</div>`;
      if (r.daily && !r.earned) t += `<div style="font-size:14px;opacity:.75">Monedas diarias solo 1 vez al día. – Tagesmünzen gibt es nur 1x pro Tag.</div>`;
      if (r.perfectNew) t += `<div style="font-size:22px;font-weight:800;margin-top:6px">👑 ¡MAESTRO/A! Sin ningún error. – Ohne einen einzigen Fehler!</div>`;
      if ("streak" in r.state && !prevStreakToday && r.state.streak > 0) t += `<div style="font-size:20px;font-weight:800;margin-top:6px;color:#ff9a2a">🔥 ¡Racha de ${r.state.streak} día${r.state.streak > 1 ? "s" : ""}!</div><div style="font-size:14px;opacity:.75">Juega mañana otra vez para no perderla. – Spiel morgen wieder, sonst ist die Serie weg.</div>`;
      if (prevLevel && r.state.level > prevLevel) t += `<div style="font-size:22px;font-weight:800;margin-top:6px">🎉 ¡SUBES DE NIVEL! Nivel ${r.state.level}</div>`;
      if (r.retoNew) t += `<div style="font-size:20px;font-weight:800;margin-top:6px;color:#3fd27a">🏅 ¡Retos de la semana completados! +${(r.state.retos && r.state.retos.reward) || 60} 🪙</div><div style="font-size:14px;opacity:.75">Alle 3 Wochen-Aufgaben geschafft!</div>`;
      const wish = r.state.wish && byId[r.state.wish];
      if (wish && wish.price && prevCoins < wish.price && r.state.coins >= wish.price && r.state.owned.indexOf(wish.id) < 0) t += `<div style="font-size:20px;font-weight:800;margin-top:6px;color:#ffd23a">🎯 ¡Ya puedes comprar tu objetivo: ${wish.name}!</div><div style="font-size:14px;opacity:.75">Du hast genug Münzen für dein Ziel – ab in die Tienda!</div>`;
      box.innerHTML = t;
      rewardFx(box, r.earned);
      if (prevLevel && r.state.level > prevLevel) setTimeout(() => levelUp(prevLevel, r.state), 1300);
    };
    if (!se) { box.innerHTML = "🪙 Inicia sesión en la página principal para ganar monedas. <div style='font-size:14px;opacity:.75'>Melde dich auf der Startseite an, um Münzen zu sammeln.</div>"; return; }
    if (S.reportedResult) { show(S.reportedResult); return; }
    box.textContent = "Guardando tus monedas … 🪙";
    const data = { game: game, mistakes: S.mistakes, secs: S.end && S.start ? Math.round((S.end - S.start) / 1000) : 0, total: S.total || 0, wrong: S.wrongWords || [], fixed: S.fixedWords || [] };
    call("result", data).then(r => {
      if (r.ok) { S.reportedResult = r; save(); show(r); }
      else if (r.error === "network") { const q = qGet(); q.push({ id: Date.now() + "-" + Math.random().toString(36).slice(2), nr: se.nr, data: data }); qSet(q); S.reportedResult = { queued: true }; save(); show(S.reportedResult); }
      else box.innerHTML = "⚠️ " + errText(r.error) + " <button onclick='location.reload()' style='font-size:16px'>Otra vez</button>";
    });
  }

